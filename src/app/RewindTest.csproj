<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- These aren't C# code, so MSBuild ignores them by default. This tells
       it to copy them next to the built .exe so RewindCore.dll (and the
       test core + ROM) are actually there when we run the program. -->
  <ItemGroup>
    <None Include="RewindCore.dll;fceumm_libretro.dll;nestest.nes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
